# Anemia Diet System — Environment Variables
# Copy this file to .env and fill in your actual keys.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Required: set the model for CrewAI agents.

# Examples matching your provider:
#   OPENAI_API_KEY=sk-...
#   ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=your_groq_api_key_here
#   GOOGLE_API_KEY=...

# ── Safety Crew Settings ──────────────────────────────────────────────────────
# SAFETY_AUDIT_LOG_RETENTION_DAYS=90

# ── Debug / Logging ───────────────────────────────────────────────────────────
# CREWAI_VERBOSE=true
